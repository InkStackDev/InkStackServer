# 生产环境配置模板（复制为 prod.env 后填写真实值；prod.env 已被 .gitignore 忽略）
WORK_PATH=/home/web/apps/server
# 备份/导出/上传等文件根目录；多机部署时指向共享存储
DATA_PATH=/home/web/apps/data
# 日志目录（生产统一放 /data/apps；留空则使用 WORK_PATH/logs）
LOG_DIR=/data/apps/logs
LOG_LEVEL=info
# 进程标题前缀（ps/top 可读）；集群渲染时会追加 -<实例名>，如 techhaven-server_1
PROCESS_NAME=techhaven
# 接入端口；同机多实例时每个实例一组（如 8090/8091、8190/8191）
HTTP_PORT=8090
WS_PORT=8091
MYSQL_HOST=change.me
MYSQL_PORT=3306
MYSQL_USER=change.me
MYSQL_PASSWD=change.me
MYSQL_DBNAME=techhaven
REDIS_HOST=127.0.0.1:6379
REDIS_DBNAME=blog

# InkStackSearchServer RPC Hub 地址
SEARCH_HUB_ADDRESS=127.0.0.1:9010

# RPC Hub 客户端（hub 地址默认与 SEARCH_HUB_ADDRESS 相同；独立部署时改这里）
# bus_id = <zone>.<group>.<service>.<instance>，service=2 表示 App；每个实例的末段必须唯一
INSTANCE_ID=1
RPC_HUB_ADDRESS=127.0.0.1:9010
RPC_BUS_ID=1.1.2.1

# 首次部署的超级管理员初始密码（仅当库中不存在 admin.email 对应账号时使用）
# 请填写强密码；已存在的管理员密码不会被覆盖
ADMIN_PASSWD=

# GitHub OAuth 登录（生产环境）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://change.me/api/v1/user/oauth/github/callback
FRONTEND_BASE=https://change.me

# 会话 Cookie：生产环境必须为 true
AUTH_COOKIE_SECURE=true

# WebAuthn / Passkey（生产环境）
WEBAUTHN_RP_ID=change.me
WEBAUTHN_RP_NAME=InkStack
WEBAUTHN_ORIGIN=https://change.me
WEBAUTHN_USER_HANDLE_SECRET=
