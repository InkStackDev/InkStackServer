# 开发环境配置（提交到 git，不包含生产密钥）
# WORK_PATH 可不设置，留空时自动使用仓库根目录
LOG_LEVEL=debug
PROCESS_NAME=techhaven-dev
HTTP_PORT=8090
WS_PORT=8091
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWD=123456
MYSQL_DBNAME=techhaven
REDIS_DBNAME=blog_dev
REDIS_HOST=127.0.0.1:6379
DATA_PATH=""
SEARCH_HUB_ADDRESS=127.0.0.1:9010

# RPC Hub 客户端（当前 hub 由 InkStackSearchServer 提供）
# bus_id 第 4 段与 INSTANCE_ID 保持一致；每起一个新实例要改 RPC_BUS_ID 末段
INSTANCE_ID=1
RPC_HUB_ADDRESS=127.0.0.1:9010
RPC_BUS_ID=1.1.2.1

# 开发环境超级管理员初始密码（仅首次创建管理员时使用）
ADMIN_PASSWD=admin123456

# GitHub OAuth 登录（开发环境）
# 在 https://github.com/settings/developers 新建 OAuth App 后填入 Client ID / Secret
# callback_url 必须与 OAuth App 的 Authorization callback URL 完全一致
GITHUB_CLIENT_ID=xxxx
GITHUB_CLIENT_SECRET=xxx
GITHUB_CALLBACK_URL=http://localhost:5173/api/v1/user/oauth/github/callback
FRONTEND_BASE=http://localhost:5173

# 会话 Cookie（本地 HTTP 调试设为 false，生产必须为 true）
AUTH_COOKIE_SECURE=false

# WebAuthn / Passkey（开发环境）
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME="InkStack Dev"
WEBAUTHN_ORIGIN=http://localhost:5173
WEBAUTHN_USER_HANDLE_SECRET=dev-webauthn-change-me
